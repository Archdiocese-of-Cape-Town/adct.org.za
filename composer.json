{
    "name": "adct/parish-intake",
    "description": "Parish event intake for adct.org.za: offline-first parsing of parish emails, confirmation, approval and publishing.",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.2",
        "prinsfrank/pdfparser": "^3.4",
        "zbateson/mail-mime-parser": "^4.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
            "brianhenryie/strauss": "^0.30",
            "phpunit/phpunit": "^11.5"
        },
    "autoload": {
        "psr-4": {
            "ADCT\\ParishIntake\\Core\\": "src/Core/",
            "ADCT\\ParishIntake\\WordPress\\": "src/WordPress/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ADCT\\ParishIntake\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0",
            "ext-gd": "2.3.3"
        },
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "ADCT\\ParishIntake\\Dependencies\\",
            "classmap_prefix": "ADCT_ParishIntake_Dependencies_",
            "constant_prefix": "ADCT_PI_DEP_",
            "classmap_output": true,
            "exclude_git_files": true,
            "exclude_from_copy": {
                "file_patterns": [
                    "~(^|/)(?:\\.github|docs)(/|$)~"
                ]
            }
        }
    },
    "scripts": {
        "test": [
            "phpunit",
            "@php tests/parser_smoke_test.php"
        ],
        "fixture-score": "@php scripts/fixture-score.php",
        "test:unit": "phpunit --testsuite unit",
            "test:integration": "npm run test:integration",
            "build-zip": "vendor/bin/strauss"
        },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite and the prototype smoke test.",
        "fixture-score": "Report parser fixture fields correct per fixture and overall.",
        "test:unit": "Run only the unit test suite.",
        "test:integration": "Run WordPress integration tests against the built release zip."
    }
}
